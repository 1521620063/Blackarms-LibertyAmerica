# Copy to frontend/.env for local development and preview.
# Proxy /lan to this backend. This value is not exposed to the browser.
BACKEND_URL=http://127.0.0.1:3000

# Optional: connect directly to another origin instead of using /lan proxy.
# This value is embedded in the frontend at build time; rebuild after changing it.
# VITE_BACKEND_URL=https://api.example.com

# Optional trusted HTTPS certificate for LAN WebGPU access.
# Paths are relative to frontend/ (absolute paths also work).
# FRONTEND_TLS_KEY=D:/certs/facility-key.pem
# FRONTEND_TLS_CERT=D:/certs/facility.pem
