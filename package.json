{
  "name": "blackarms-liberty-america",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend"],
  "scripts": {
    "setup:https": "node scripts/setup-https.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "cargo run --locked --manifest-path backend/Cargo.toml",
    "compress:images": "node scripts/compress-images.mjs",
    "build": "npm run build --workspace frontend",
    "benchmark:simulation": "node scripts/benchmark-simulation.mjs",
    "start": "cargo run --release --locked --manifest-path backend/Cargo.toml",
    "preview": "npm run preview --workspace frontend",
    "test": "node --test tests/*.test.js",
    "test:backend": "cargo test --locked --manifest-path backend/Cargo.toml",
    "test:webgpu": "node tests/webgpu.mjs",
    "test:environment": "node tests/environment.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:startup": "node tests/startup.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:wet-light": "node tests/wet-light.mjs",
    "test:audio": "node tests/audio.mjs",
    "test:arsenal": "node tests/arsenal.mjs",
    "test:art": "node tests/art.mjs",
    "test:muzzle": "node tests/muzzle-flash.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "ws": "^8.18.3"
  },
  "volta": {
    "node": "24.22.3"
  }
}