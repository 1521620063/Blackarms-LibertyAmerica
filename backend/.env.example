# Copy to backend/.env. Environment variables override this file.
# local: loopback by default; lan/public: listen on all interfaces by default.
APP_MODE=local
PORT=3000
# HOST=127.0.0.1

# Comma-separated browser origins, including scheme and non-default ports.
# Public mode requires this list and checks it even behind a same-origin proxy.
ALLOWED_ORIGINS=
# ALLOWED_ORIGINS=https://game.example.com,https://api.example.com

# HTTPS/WSS terminates at Nginx or Caddy. Rust listens on internal HTTP.
# Optional custom .env location, useful for a deployed executable:
# BACKEND_ENV_FILE=/etc/blackarms/backend.env
